# Django Core
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL & PgBouncer
POSTGRES_DB=knitau
POSTGRES_USER=knitau_app
POSTGRES_PASSWORD=
DATABASE_URL=
READ_REPLICA_URL=

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# Object Storage (S3 / MinIO for KYC docs, Exit Letters, PPE Receipts)
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_NAME=knitau-vault
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Safaricom Daraja / M-Pesa B2C & Webhook Verification
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_WEBHOOK_HMAC_SECRET=

# USSD & SMS Gateway (Africa's Talking)
AT_USERNAME=
AT_API_KEY=
AT_SHORTCODE=
USSD_WEBHOOK_SECRET=
